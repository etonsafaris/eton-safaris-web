{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "npm run build",
  "regions": ["fra1"],
  "env": {
    "SKIP_BUILD_STAYS": "1",
    "SKIP_BUILD_STATIC_PARAMS": "1",
    "NEXT_PUBLIC_SITE_URL": "https://etonsafaris.com"
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.etonsafaris.com" }],
      "destination": "https://etonsafaris.com/:path*",
      "permanent": true
    }
  ]
}
