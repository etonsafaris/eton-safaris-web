{
  "crons": [
    {
      "path": "/api/cron/newsletter",
      "schedule": "0 8 * * *"
    }
  ],
  "functions": {
    "app/page.tsx": {
      "maxDuration": 30
    },
    "app/sitemap.ts": {
      "maxDuration": 60
    },
    "app/api/**": {
      "maxDuration": 30
    }
  },
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "framework": "nextjs"
}
