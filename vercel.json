{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "npm run build",
  "regions": ["fra1"],
  "env": {
    "SKIP_BUILD_STAYS": "1",
    "SKIP_BUILD_STATIC_PARAMS": "1",
    "BUILD_STATIC_PARAMS_LIMIT": "64",
    "NEXT_PUBLIC_SITE_URL": "https://www.etonsafaris.com"
  },
  "rewrites": [
    { "source": "/api/health", "destination": "/api/system/health" }
  ],
  "headers": [
    {
      "source": "/api/health",
      "headers": [{ "key": "Cache-Control", "value": "no-store, must-revalidate" }]
    }
  ],
  "functions": {
    "app/api/public/**/*.ts": {
      "maxDuration": 30
    },
    "app/api/media/**/*.ts": {
      "maxDuration": 30
    },
    "app/api/data/**/*.ts": {
      "maxDuration": 30
    },
    "app/api/admin/records/route.ts": {
      "maxDuration": 30
    },
    "app/api/upload/route.ts": {
      "maxDuration": 60
    },
    "app/api/system/health/route.ts": {
      "maxDuration": 15
    }
  }
}
