# Copy to .env.local and fill in live values. Never commit secrets.

# Aiven PostgreSQL Database (CMS data + uploaded images in `media_files`, served as /api/media/{id})
# Copy the full "Service URI" from Aiven Console → your PG service → Connection information.
# If admin shows getaddrinfo ENOTFOUND, the hostname here is stale — paste a fresh URI and redeploy.
DATABASE_URL=
# Cloudflare Workers: set DATABASE_URL as an encrypted Worker secret (or use Hyperdrive binding HYPERDRIVE in wrangler.jsonc).
# Build-time (optional, matches former vercel.json): SKIP_BUILD_STAYS=1 SKIP_BUILD_STATIC_PARAMS=1
# Optional: per-process pool size (hard cap 15 for Aiven free tier)
# PG_POOL_MAX=5
# PG_SLOT_MAX=4

# Admin authentication
ADMIN_EMAIL=etonsafaris@gmail.com
# Required for emergency owner login if Aiven is temporarily unavailable. Use a strong secret (8+ characters).
ADMIN_PASSWORD=

# Email notifications (Resend)
# Website alerts always go to etonsafaris@gmail.com. Resend sends them; add your API key below.
RESEND_API_KEY=
RESEND_FROM=Eton Safaris <onboarding@resend.dev>

# Payment integration (Pesapal)
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_ENV=live
PESAPAL_IPN_ID=

# Cron job security
CRON_SECRET=

# Site configuration
NEXT_PUBLIC_SITE_URL=https://etonsafaris.com
# Optional: after deploy, probe DB with GET /api/health?deep=1
